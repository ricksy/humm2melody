# Copy to web/scripts/pwa.env and fill in. That file is gitignored: this
# repository is public and deployment targets are infrastructure, the same
# convention docs/MAINTENANCE.md §5 uses for the blog.
#
#   cp web/scripts/pwa.env.example web/scripts/pwa.env
#
# PWA_HOST is very likely the same machine as BLOG_HOST in scripts/blog.env —
# the one already serving the site. PWA_PATH is a directory that host serves
# over HTTPS; getUserMedia and service workers both require it, so plain HTTP
# will not work anywhere except localhost.

PWA_HOST=your-ssh-host-alias
PWA_PATH=/path/to/served/humm2melody
PWA_URL=https://example.com/humm2melody/
